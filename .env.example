# Copy this file to .env.local and paste values from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Optional: keep the same domain used for the internal Auth email usernames.
NEXT_PUBLIC_SEC_LOGIN_DOMAIN=sec-transport-login.com
